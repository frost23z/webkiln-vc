{% import "_macros.html.j2" as m %}
<section class="section section--alt" id="{{ entry.section.id }}">
  <div class="container stack">
    {{ m.heading(entry) }}
    <div class="grid {{ m.columns(entry.copy.items | length) }}">
      {% for item in entry.copy.items %}
      <figure class="card">
        <{{ entry.item_tag }}>{{ item.title }}</{{ entry.item_tag }}>
        <blockquote class="quote">{{ item.text }}</blockquote>
        <figcaption class="quote__by">{{ item.meta }}</figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
