# Copy to .env in this folder. The API and the agents both read it.

# Postgres, as started by `just db-up`. The API creates and updates its tables on startup.
DB_URL=postgresql://webkiln:webkiln@localhost:5432/webkiln
# The address of the UI, allowed by the API's CORS rules.
UI_ORIGIN=http://localhost:3000

# Every key is optional, but a research agent needs at least one provider from its chain.

# The first Google key also makes the embeddings for the long-term memory. Without one, runs work
# but nothing is remembered.
GOOGLE_API_KEYS=["your-google-ai-studio-key"]
GROQ_API_KEYS=["your-groq-key"]
OPEN_ROUTER_API_KEYS=["your-openrouter-key"]

# Web search for the competitor agent. Without it the competitor report is flagged unsourced.
TAVILY_API_KEY=

# Optional: override a role's models, as provider:model,provider:model (first one wins).
# Providers: google, groq, openrouter. Free-tier model IDs change, so edit these if one fails.
# MODEL_MANAGER=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free,groq:openai/gpt-oss-120b
# MODEL_NICHE=google:gemini-2.5-flash,groq:openai/gpt-oss-120b
# MODEL_AUDIENCE=
# MODEL_COMPETITOR=
# MODEL_SEO=
# MODEL_BRAND=
# MODEL_WIREFRAME=
# MODEL_CONTENT=
# MODEL_IMAGES=
