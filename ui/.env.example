# Base URL of the Webkiln API. Copy this file to .env.local and adjust it.
# NEXT_PUBLIC_ values are inlined at build time, so restart `pnpm dev` after a change.
NEXT_PUBLIC_API_URL=http://localhost:8000
# On Vercel (one project, two services) the API is served on the same domain under /api:
# NEXT_PUBLIC_API_URL=/api
